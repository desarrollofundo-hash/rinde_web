<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Configuración de iisnode -->
    <iisnode
      nodeProcessCommandLine="node.exe"
      interceptor="iisnode.dll"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="false"
    />

    <!-- Rewrite rules para Node.js -->
    <rewrite>
      <rules>
        <!-- Ignorar archivos de node_modules -->
        <rule name="Ignore node_modules" stopProcessing="true">
          <match url="^node_modules" />
          <action type="None" />
        </rule>

        <!-- Ignorar archivos estáticos -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^(?!api)(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Todas las otras rutas van al servidor Node.js -->
        <rule name="DynamicContent">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Manejo de errores 404 -->
    <httpErrors>
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/server.js" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Configuración de aplicación Node.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Compresión -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Límite de tamaño de contenido (50MB para imágenes OCR) -->
    <security>
      <requestFiltering>
        <requestLimits maxUrl="10240" maxQueryString="2048" maxContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
